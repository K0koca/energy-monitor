   59          //读取INA219分流电压（mV）
   60          
   61          float INA219_ReadShuntVoltage(void)
   62          {
   63   1          int16_t voltage = (int16_t)INA219_ReadReg(INA219_REG_SHUNTVOLT);
   64   1          // 分流电压LSB = 10uV，转换为mV需除以100
   65   1          return (voltage * 0.01f);
   66   1      }
   67          
   68          //读取INA219总线电压（V）
   69          float INA219_ReadBusVoltage(void)
   70          {
   71   1          uint16_t voltage = INA219_ReadReg(INA219_REG_BUSVOLT);
   72   1          // 总线电压LSB = 4mV，需右移3位舍弃状态位后乘以4
   73   1          
   74   1          return ((voltage >> 3) * 0.004f);
   75   1      }
   76          
   77          //读取INA219电流值（mA）
   78          
   79          float INA219_ReadCurrent(void)
   80          {
   81   1          // 电流LSB由校准值决定，示例中校准值4096对应1mA/LSB
   82   1          int16_t raw = (int16_t)INA219_ReadReg(INA219_REG_CURRENT);
   83   1          return raw * INA219_CURRENT_LSB *1004;
   84   1      }
   85          
   86          //读取INA219功率值（mW）
   87          
   88          float INA219_ReadPower(void)
   89          {
   90   1          // 功率LSB = 20*电流LSB（示例中为20mW/LSB）
   91   1          uint16_t raw = INA219_ReadReg(INA219_REG_POWER);
   92   1          return raw * INA219_POWER_LSB *994;
   93   1      }
