   10          //向INA219寄存器写入16位数据
   11          
   12          static void INA219_WriteReg(uint8_t reg_addr, uint16_t dat)
   13          {
   14   1          while (I2C_CheckMasterBusy());  // 等待I2C总线空闲
   15   1          I2C_ClearMasterFlag();          // 清除完成标志
   16   1          
   17   1          // 发送I2C起始信号+设备写地址
   18   1          I2C_MasterStartSendByte(INA219_I2C_ADDR << 1);
   19   1          // 发送寄存器地址
   20   1          I2C_MasterSendByte(reg_addr);
   21   1          // 发送高8位数据
   22   1          I2C_MasterSendByte((dat >> 8) & 0xFF);
   23   1          // 发送低8位数据
   24   1          I2C_MasterSendByte(dat & 0xFF);
   25   1          
   26   1          I2C_MasterStop();               // 发送停止信号
   27   1      }
   28          
   29          //从INA219寄存器读取16位数据
   30          
   31          static uint16_t INA219_ReadReg(uint8_t reg_addr)
   32          {
   33   1          uint16_t dat = 0;
   34   1          
   35   1          while (I2C_CheckMasterBusy()); 
   36   1          I2C_ClearMasterFlag();
   37   1          I2C_MasterStartSendByte(INA219_I2C_ADDR << 1);
   38   1          I2C_MasterSendByte(reg_addr);
   39   1          
   40   1          // 发送重复起始信号+设备读地址
   41   1          I2C_MasterStartSendByte((INA219_I2C_ADDR << 1) | 0x01);
   42   1          // 读取高8位（发送ACK）
   43   1          dat = (uint16_t)I2C_MasterReadByte(0) << 8;
   44   1          // 读取低8位（发送NAK）
   45   1          dat |= (uint16_t)I2C_MasterReadByte(1);
   46   1          
   47   1          I2C_MasterStop();  // 发送停止信号
   48   1          
   49   1          return dat;
   50   1      }
   51          
   52          //初始化INA219芯片
   53          void INA219_Init(void)
   54          {
   55   1          INA219_WriteReg(INA219_REG_CONFIG, 0x07FF); // 0x07FF = 0000 0111 1111 1111
   56   1          INA219_WriteReg(INA219_REG_CALIBRATION, INA219_CALIBRATION_VAL);
   57   1      }
