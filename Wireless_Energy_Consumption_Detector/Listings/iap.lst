   87          //========================================================================
   88          // 函数: void EEPROM_read_n(u32 EE_address,u8 *DataAddress,u16 number)
   89          // 描述: 从指定EEPROM首地址读出n个字节放指定的缓冲.
   90          // 参数: EE_address:  读出EEPROM的首地址.
   91          //       DataAddress: 读出数据放缓冲的首地址.
   92          //       number:      读出的字节长度.
   93          // 返回: non.
   94          // 版本: V1.0, 2012-10-22
   95          //========================================================================
   96          void EEPROM_read_n(u32 EE_address,u8 *DataAddress,u16 number)
   97          {
   98   1        do
   99   1        {
  100   2          *DataAddress = IAP_ReadByte(EE_address);            //读出的数据送往
  101   2          EE_address++;
  102   2          DataAddress++;
  103   2        }while(--number);
  104   1      
  105   1      }
  106          
  107          //========================================================================
  108          // 函数: void EEPROM_write_n(u32 EE_address,u8 *DataAddress,u16 number)
  109          // 描述: 把缓冲的n个字节写入指定首地址的EEPROM.
  110          // 参数: EE_address:  写入EEPROM的首地址.
  111          //       DataAddress: 写入源数据的缓冲的首地址.
  112          //       number:      写入的字节长度.
  113          // 返回: non.
  114          // 版本: V1.0, 2012-10-22
  115          //========================================================================
  116          void EEPROM_write_n(u32 EE_address,u8 *DataAddress,u16 number)
  117          {
  118   1        do
  119   1        {
  120   2          IAP_ProgramByte(EE_address, *DataAddress);
  121   2          EE_address++;                     //下一个地址
  122   2          DataAddress++;                    //下一个数据
  123   2        }while(--number);                   //直到结束
  124   1      }
