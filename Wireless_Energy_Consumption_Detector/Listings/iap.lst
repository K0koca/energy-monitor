   59          void IAP_ProgramByte(uint32_t dwAddress, uint8_t bData)
   60          {
   61   1          IAP_SetAddress(dwAddress);          //设置EEPROM目标地址
   62   1          IAP_SetData(bData);                 //设置EEPROM数据
   63   1          IAP_TriggerProgram();               //触发EEPROM字节编程
   64   1          IAP_Idle();                         //恢复EEPROM空闲模式
   65   1      }
   66          
