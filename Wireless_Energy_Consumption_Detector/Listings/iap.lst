   68          // EEPROM字节读取函数
   69          // 入口参数: dwAddress (EEPROM目标字节地址)
   70          // 函数返回: (读取的字节数据)
   71          ////////////////////////////////////////
   72          uint8_t IAP_ReadByte(uint32_t dwAddress)
   73          {
   74   1          uint8_t dat;
   75   1      
   76   1          IAP_SetAddress(dwAddress);          //设置EEPROM目标地址
   77   1          IAP_TriggerRead();                  //触发EEPROM字节读取
   78   1          dat = IAP_ReadData();               //保存EEPROM数据
   79   1          IAP_Idle();                         //恢复EEPROM空闲模式
