  129          ////////////////////////////////////////
  130          // I2C读AT24C02函数
  131          // 入口参数: addr (EEPROM目标地址)
  132          //           dat  (数据缓冲区)
  133          //           size (数据大小)
  134          // 函数返回: 无
  135          ////////////////////////////////////////
  136          #define AT24C02_SLAW            0xa0    //写设备地址
  137          #define AT24C02_SLAR            0xa1    //读设备地址
  138          #define AT24C02_PAGE_SIZE       8       //页编程大小
  139          
  140          void I2C_ReadAT24C02(uint8_t addr, uint8_t *dat, uint8_t size)
  141          {
  142   1          while (I2C_CheckMasterBusy());      //等待I2C模块退出忙状态
  143   1          I2C_ClearMasterFlag();              //清除完成标志
  144   1          // DMA_I2C_DisableDMA();            //如果已使能DMA，此处必须禁止DMA，寄存器操作模式才可正常工作
  145   1      
  146   1          I2C_MasterStartSendByte(AT24C02_SLAW); //发送起始信号+设备写信号
  147   1          I2C_MasterSendByte(addr);           //发送地址信息
  148   1      
  149   1          I2C_MasterStartSendByte(AT24C02_SLAR); //发送起始信号+设备读信号
  150   1          while (size--)                      //判断数据是否读取完成
  151   1          {
  152   2              *dat++ = I2C_MasterReadByte(!size); //读取数据
  153   2          }
  154   1      
  155   1          I2C_MasterStop();                   //发送停止信号
  156   1      }
  157          
  158          ////////////////////////////////////////
  159          // I2C写AT24C02函数
  160          // 入口参数: addr (EEPROM目标地址)
  161          //           dat  (数据缓冲区)
  162          //           size (数据大小)
  163          // 函数返回: 无
  164          ////////////////////////////////////////
  165          void I2C_WriteAT24C02(uint8_t addr, uint8_t *dat, uint8_t size)
  166          {
  167   1          while (I2C_CheckMasterBusy());      //等待I2C模块退出忙状态
  168   1          I2C_ClearMasterFlag();              //清除完成标志
  169   1          // DMA_I2C_DisableDMA();            //如果已使能DMA，此处必须禁止DMA，寄存器操作模式才可正常工作
  170   1      
  171   1          while (size)
  172   1          {
  173   2              I2C_MasterStartSendByte(AT24C02_SLAW); //发送起始信号+设备写信号
  174   2              I2C_MasterSendByte(addr);       //发送地址信息
  175   2              while (size)                    //判断数据是否发送完成
  176   2              {
  177   3                  I2C_MasterSendByte(*dat++); //发送数据
  178   3                  size--;
  179   3                  addr++;
  180   3                  if ((addr & (AT24C02_PAGE_SIZE - 1)) == 0)
  181   3                      break;                  //防止跨页编程
  182   3              }
  183   2              I2C_MasterStop();               //发送停止信号
  184   2      
  185   2              delay_ms(5);                    //等待AT24C02编程完成
  186   2          }
  187   1      }
