   32          void TIMER0_Init(void)
   33          {
   34   1      #define T0_PSCR                 (1)
   35   1      #define T0_RELOAD               (65536 - (float)SYSCLK / (T0_PSCR + 1) * 1 / 1000) //定时周期1毫秒
   36   1      
   37   1          TIMER0_TimerMode();                 //设置定时器0为定时模式
   38   1          TIMER0_1TMode();                    //设置定时器0为1T模式
   39   1          TIMER0_Mode0();                     //设置定时器0为模式0 (16位自动重载模式)
   40   1          TIMER0_DisableGateINT0();           //禁止定时器0门控
   41   1          TIMER0_SetIntPriority(3);           //设置中断为最高优先级
   42   1          TIMER0_EnableInt();                 //使能定时器0中断
   43   1          TIMER0_SetPrescale(T0_PSCR);        //设置定时器0的8位预分频
   44   1          TIMER0_SetReload16(T0_RELOAD);      //设置定时器0的16位重载值
   45   1          TIMER0_Run();                       //定时器0开始运行
   46   1      
