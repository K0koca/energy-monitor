   90          void UART1_ReceiveHandler(uint8_t rec_byte)
   91          {
   92   1          switch (UART_State) {
   93   2              case UART_SEARCH_HEADER1:
   94   2                  if (rec_byte == FRAME_HEADER1) {
   95   3                      u8RTC_Frame_Buffer[0] = rec_byte;
   96   3                      UART_State = UART_SEARCH_HEADER2;
   97   3                  }
   98   2                  break;
   99   2              case UART_SEARCH_HEADER2:
  100   2                  if (rec_byte == FRAME_HEADER2) {
  101   3                      u8RTC_Frame_Buffer[1] = rec_byte;
  102   3                      UART_State = UART_SEARCH_HEADER3;
  103   3                  } else {
  104   3                      UART_State = UART_SEARCH_HEADER1; // 帧头错误，重置
  105   3                  }
  106   2                  break;
  107   2              case UART_SEARCH_HEADER3:
  108   2                  if (rec_byte == FRAME_HEADER3) {
  109   3                      u8RTC_Frame_Buffer[2] = rec_byte;
  110   3                      UART_State = UART_RECEIVE_CMD; // 接收指令类型
  111   3                  } else {
  112   3                      UART_State = UART_SEARCH_HEADER1; // 帧头错误，重置
  113   3                  }
  114   2                  break;
  115   2              case UART_RECEIVE_CMD:
  116   2                  // 保存指令类型，并确定当前帧总长度
  117   2                  u8RTC_Frame_Buffer[3] = rec_byte;
  118   2                  switch (rec_byte) {
  119   3                      case CMD_SET_PW_TH:
  120   3                          u8CurrentFrameLen = RTC_FRAME_LEN_PW_TH;
  121   3                          break;
  122   3                      case CMD_SET_TIME:
  123   3                          u8CurrentFrameLen = RTC_FRAME_LEN_SEEP;
